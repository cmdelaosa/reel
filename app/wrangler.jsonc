{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reel",
  "compatibility_date": "2026-07-20",

  // Casi todo lo que sirve este Worker son ficheros estáticos, y `assets` los
  // sirve sin pasar por aquí. La única excepción es la vuelta de Steam, que
  // tiene que aterrizar en NUESTRO dominio para que la pantalla de OpenID diga
  // "Sign in to reel-app.com" y no el host del proyecto de Supabase — el
  // motivo entero está en src/worker/steamReturn.ts.
  "main": "./src/worker/index.ts",

  // `single-page-application` devuelve index.html (200) para cualquier ruta que
  // no sea un fichero del build, que es lo que React Router necesita en los
  // enlaces profundos. `run_worker_first` es la lista de rutas que se saltan
  // esa regla: sin ella, /api/steam/return devolvería la app en vez de llegar
  // al código de aquí.
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/steam/*"]
  },

  // A dónde reenvía la vuelta de Steam. Vive AQUÍ y no en los secretos del
  // dashboard porque el 27-ago-2026 se probó al revés: puesto como Secret en
  // «Runtime variables and secrets», el primer despliegue de Workers Builds lo
  // dejó fuera y la ruta empezó a contestar «SUPABASE_URL not configured» sin
  // que nada avisara. Lo que este fichero declara se despliega con el Worker;
  // lo que solo está en la consola depende de que nadie lo pise.
  //
  // Y no es un secreto: es el origen público del proyecto, el mismo que Vite
  // incrusta en el bundle —está cinco veces en el index-*.js que sirve esta
  // misma app— y que viaja en cada petición del navegador. Lo que sí es
  // credencial son las claves, y ninguna está aquí.
  "vars": {
    "SUPABASE_URL": "https://kjdnjuicghemusfiiign.supabase.co"
  }
}
