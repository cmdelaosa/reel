{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reel",
  "compatibility_date": "2026-07-20",

  // Static-only Worker: no `main`, the build output is served directly.
  // `single-page-application` returns index.html (200) for any path that
  // isn't a built asset, which is what React Router needs on deep links.
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
