# Edge Function secrets — NEVER commit real values.
#
# Hosted: set with `supabase secrets set TMDB_API_KEY=... RESEND_API_KEY=...`
#         (requires `supabase link --project-ref <ref>` first).
# Local:  copy this file to `supabase/.env` (gitignored) and fill it, then
#         `supabase functions serve --env-file supabase/.env`.

# TMDB v3 API key — used by the tmdb-proxy edge function (P0-C9).
TMDB_API_KEY=

# OMDb API key — IMDb ratings for the detail sheet and the episode graph
# (tmdb-proxy + episode-refresh, bridged via imdb_id). Free tier is 1,000/day;
# the $1/mo tier (100,000/day) clears the one-shot library backfill in minutes.
# OPTIONAL: unset, IMDb scores just never populate — nothing else breaks.
OMDB_API_KEY=

# Resend API key — used by the email/alerts edge functions (Phase 3).
RESEND_API_KEY=
