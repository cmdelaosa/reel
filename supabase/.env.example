# Edge Function secrets — NEVER commit real values.
#
# Hosted: set with `supabase secrets set TMDB_API_KEY=... RESEND_API_KEY=...`
#         (requires `supabase link --project-ref <ref>` first).
# Local:  copy this file to `supabase/.env` (gitignored) and fill it, then
#         `supabase functions serve --env-file supabase/.env`.

# TMDB credential — tmdb-proxy (P0-C9), the episode-refresh cron and the
# importer. Either form works and the code tells them apart by shape:
#
#   v3 API key            32 hex characters. Travels as `?api_key=` in the URL,
#                         because TMDB accepts it no other way.
#   v4 read access token  a JWT (`eyJ…`), from the same TMDB API settings page.
#                         Travels as an `Authorization: Bearer` header, so the
#                         credential never appears in a URL at all.
#
# Prefer the v4 token. A URL is the one part of a request that ends up quoted
# back at you — a failed connection puts it in the error message, which is how
# this key used to reach the browser and the job_runs table. See
# supabase/functions/_shared/tmdb.ts.
TMDB_API_KEY=

# Twitch app credentials — used by the igdb-proxy edge function (videojuegos).
# IGDB es de Twitch: se registran UNA vez en dev.twitch.tv/console/apps con
# Client Type "Confidential", y son del proyecto, no de cada usuario. Sin ellas
# igdb-proxy responde 500 y el resto de la app no se entera.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Resend API key — used by the email/alerts edge functions (Phase 3).
RESEND_API_KEY=
